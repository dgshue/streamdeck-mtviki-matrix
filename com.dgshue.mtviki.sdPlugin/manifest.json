{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "MT-VIKI HDMI Matrix",
	"UUID": "com.dgshue.mtviki",
	"Version": "1.0.0.0",
	"Author": "dgshue",
	"Description": "Control an MT-VIKI 4K HDMI matrix over LAN. Swap the sources on a pair of outputs with one key, or route an input to fixed outputs.",
	"Category": "MT-VIKI Matrix",
	"CategoryIcon": "imgs/plugin/category-icon",
	"Icon": "imgs/plugin/marketplace",
	"CodePath": "bin/plugin.js",
	"SDKVersion": 2,
	"Software": {
		"MinimumVersion": "6.5"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		},
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		}
	],
	"Nodejs": {
		"Version": "20",
		"Debug": "enabled"
	},
	"Actions": [
		{
			"Name": "Swap Pair",
			"UUID": "com.dgshue.mtviki.swap",
			"Icon": "imgs/actions/swap/icon",
			"Tooltip": "Exchange the two sources feeding a pair of outputs, e.g. the top and bottom monitor on one side.",
			"PropertyInspectorPath": "ui/swap.html",
			"Controllers": ["Keypad"],
			"UserTitleEnabled": false,
			"States": [
				{
					"Image": "imgs/actions/swap/key",
					"TitleAlignment": "bottom",
					"FontSize": 12
				}
			]
		},
		{
			"Name": "Set Route",
			"UUID": "com.dgshue.mtviki.route",
			"Icon": "imgs/actions/route/icon",
			"Tooltip": "Send one input to a fixed set of outputs.",
			"PropertyInspectorPath": "ui/route.html",
			"Controllers": ["Keypad"],
			"States": [
				{
					"Image": "imgs/actions/route/key",
					"TitleAlignment": "bottom",
					"FontSize": 12
				}
			]
		}
	]
}
